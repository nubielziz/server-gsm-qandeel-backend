# Every variable the backend reads (src/config/env.ts, decision 013). Copy to .env and adjust. Never commit real secrets.
# Local defaults match compose.yaml (`docker compose up -d`); outside production every value below is optional.
# In production the values marked REQUIRED must be set, and the development secrets (CSRF_SECRET, TOKEN_PEPPER and the
# ENCRYPTION_KEYS dev key) are refused.
# Bun loads .env, .env.<NODE_ENV> and .env.local itself; tests set NODE_ENV=test.

# --- Process and HTTP ---------------------------------------------------------------------------------------------
NODE_ENV=development                 # development | test | production; unset = development, which refuses a database that is not on this machine (decision 055)
PORT=3000                            # API port
HOST=0.0.0.0                         # API bind address
LOG_LEVEL=                           # fatal|error|warn|info|debug|trace|silent; default info (prod), debug (dev), warn (test)
TRUST_PROXY=                         # empty/false = trust none; a hop count (1-10) or a list "10.0.0.0/8,loopback"; production requires it (the exact proxy addresses; `false` when there is no proxy, decision 055)
BODY_LIMIT_BYTES=1048576             # largest JSON body (uploads and the Dhru endpoint's form bodies use their own limits)
HTTP_HEADERS_TIMEOUT_MS=20000        # the headers of a request must arrive within this (100-120000)
HTTP_REQUEST_TIMEOUT_MS=600000       # the whole request, body included (1000-3600000); a 25 MiB upload needs about 0.35 Mbit/s
CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # exact browser origins of the admin console: CORS and the Origin checks of /admin and /reference (decision 045); default these two (dev), none (test), the origin of CONSOLE_BASE_URL (production, https only)
SHOP_ORIGINS=http://localhost:5174,http://localhost:5175        # exact browser origins of the storefront (which serves the account area) and of the old portal: /client and /store/v1; default these two (dev), none (test), the origins of STORE_BASE_URL and PORTAL_BASE_URL (production, https only)
CORS_ORIGINS=                        # deprecated: read outside production as each of the two lists above that is not set, with a boot warning; production refuses it
ERRORS_BASE_URL=http://localhost:3000/errors               # REQUIRED in production, https in production; base of the problem+json "type" URI
PORTAL_BASE_URL=http://localhost:5175/account              # REQUIRED in production, https in production; the base of the account area of the shop, https://<shop host>/account (decision 064); the card top-up return address is <PORTAL_BASE_URL>/wallet
CONSOLE_BASE_URL=http://localhost:5173                     # REQUIRED in production, https in production; the admin console; staff invitation and reset links are <CONSOLE_BASE_URL>/set-password?token=...
STORE_BASE_URL=http://localhost:5175                       # REQUIRED in production, https in production; the storefront; customer links are <STORE_BASE_URL>/sign-in?token=... and /set-password?token=...
GEOIP_COUNTRY_HEADER=                # optional; the header a CDN in front of the edge writes with the visitor's ISO-2 country (e.g. cf-ipcountry): the risk rules, the tax-country check and imei_checks.country read it; only when every request passes that CDN (docs/OPERATIONS.md, Visitor country); in the production stack it is set in deploy/.env; unset = no visitor country
APP_VERSION=                          # the running build's version on the System health Overview (default 0.0.0-dev)
GIT_SHA=                              # the build's commit (first 7 characters shown; default unknown)
DEPLOYED_AT=                          # ISO time the build went live (optional)
REFERENCE_DOCS=                      # internal API reference (GET /reference): open | staff | off; default open (dev/test), staff (production); staff needs a staff session with system:read (401/403 otherwise)

# --- Postgres (decision 005). Integration and scenario tests use DATABASE_URL_TEST. ------------------------------
DATABASE_URL=postgres://gsm:gsm@localhost:5432/gsm            # REQUIRED in production
DATABASE_URL_TEST=postgres://gsm:gsm@localhost:5432/gsm_test
DATABASE_OWNER_URL=                  # the owner role for db:migrate and setup (decision 055); unset = DATABASE_URL; in production only the migrate container has it; ignored under test
PGHOST=                              # the Postgres driver's own variable: the host it uses when a database URL names none; read only to judge whether the database is on this machine (decision 055); leave empty
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=          # default 15000 (none under NODE_ENV=test); 0 = no limit; longest statement of this process; the production worker gets 300000 (deploy/compose.prod.yaml)
DATABASE_LOCK_TIMEOUT_MS=               # default 5000 (none under test); 0 = no limit; longest wait for a lock; the production worker gets 30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS= # default 60000 (none under test); 0 = no limit; a transaction left idle longer is ended by Postgres

# --- Two Redis roles (decision 006): BullMQ only on the queue instance, cache/rate limits/locks on the cache one. ---
REDIS_QUEUE_URL=redis://localhost:6379/0                      # REQUIRED in production
REDIS_CACHE_URL=redis://localhost:6380/0                      # REQUIRED in production
BULL_PREFIX=                         # default gsm:<env>:bull; the prefix of every BullMQ key (docs/queues.md)
REDIS_QUEUE_URL_TEST=                # NODE_ENV=test only (the two URLs above are ignored then); default redis://localhost:6379/1
REDIS_CACHE_URL_TEST=                # NODE_ENV=test only; default redis://localhost:6380/1

# --- S3-compatible storage (decision 004); local MinIO from compose.yaml. -----------------------------------------
S3_ENDPOINT=http://localhost:9000    # empty = local MinIO outside production, AWS default endpoint in production
S3_PUBLIC_ENDPOINT=                  # the address presigned links are signed for (decision 055); unset = S3_ENDPOINT; https in production
S3_REGION=us-east-1
S3_BUCKET=gsm-files                  # REQUIRED in production
S3_BUCKET_TEST=                      # NODE_ENV=test only (S3_BUCKET is ignored then); default gsm-files-test
S3_ACCESS_KEY_ID=gsm-minio           # REQUIRED in production
S3_SECRET_ACCESS_KEY=gsm-minio-secret                         # REQUIRED in production
S3_FORCE_PATH_STYLE=true             # true for MinIO, false for AWS

# --- Sessions, CSRF and encryption (decisions 018, 019). All REQUIRED in production, never the dev defaults. ---------
CSRF_SECRET=                         # REQUIRED in production; >= 32 characters; HMAC key of the CSRF token
CSRF_COOKIE_DOMAIN=                  # Domain of the readable csrf_token cookie (cross-subdomain consoles)
COOKIE_SECURE=                       # true in production (required there); false allowed for http://localhost
TOKEN_PEPPER=                        # REQUIRED in production; >= 32 characters; HMAC key of session, one-time link and API-key hashes (rotating it signs everyone out and voids API keys and open links)
LOOKUP_HASH_KEY=                     # REQUIRED in production; >= 32 characters; HMAC key of the stored lookups (blocklist, IMEI history, inventory and order duplicates, unsubscribe links, Idempotency-Key, the shop's link tokens); unset outside production = TOKEN_PEPPER; an installation that has data sets it to its current TOKEN_PEPPER (decision 054)
ENCRYPTION_KEYS=                     # REQUIRED in production; "<kid>:<base64 of 32 bytes>[,<kid>:<key>...]", e.g. generate with `openssl rand -base64 32`
ENCRYPTION_ACTIVE_KID=               # REQUIRED in production; key id (from ENCRYPTION_KEYS) used for new encryptions
ARGON2_MEMORY_KIB=19456              # argon2id memory per password hash, in KiB (OWASP baseline: 19456 with time cost 2, parallelism 1)
ARGON2_TIME_COST=2                   # argon2id passes; tune the three values with `bun run bench:argon2` to 50-150 ms per hash on the target host
ARGON2_PARALLELISM=1                 # argon2id lanes; the memory must be at least 8 KiB per lane

# --- Observability (decision 015) -----------------------------------------------------------------------------------
METRICS_TOKEN=                       # REQUIRED in production; >= 32 characters in production; when set, /metrics needs "Authorization: Bearer <token>" from everyone; unset = loopback/private callers only
WORKER_METRICS_PORT=9464             # the worker's own /metrics listener
PROMETHEUS_URL=http://localhost:9090  # the Prometheus of compose.yaml (System health history); in production its internal URL; unset = MONITORING_UNAVAILABLE
SENTRY_DSN=                          # optional; unset = nothing is sent and the SDK never starts. Sends unexpected 5xx and jobs that failed for good, scrubbed (no request data, user, e-mail or long digit runs); decision 015

# --- Exchange rates (POST /admin/currencies/refresh-fx, RESOLUTIONS money-9; calls go through OutboundHttp) ----------
FX_PROVIDER=                         # openexchangerates | manual; default manual (dev/test), openexchangerates (production); manual = the refresh answers 502 FX_PROVIDER_DOWN
FX_API_KEY=                          # secret (openexchangerates app id); REQUIRED in production when FX_PROVIDER is openexchangerates (the production default); unset elsewhere = the refresh answers 502 FX_PROVIDER_DOWN "No exchange-rate provider is configured."
FX_TIMEOUT_MS=5000                   # explicit timeout of one provider call, 100-60000 ms (decision 023: no automatic retry)

# --- Mail, and Telegram for the operations alerts (decision 033; notifications go through the `notifications` queue) ---------
MAIL_SMTP_URL=smtp://localhost:1025  # REQUIRED in production; smtp:// or smtps:// with credentials (a secret); development: the Mailpit of compose.yaml, web UI on http://localhost:8025; NODE_ENV=test never connects
MAIL_FROM=IMEI-HUB <noreply@gsm.local>    # REQUIRED in production; the sender of every mail: an address or "Name <address>"
TELEGRAM_BOT_TOKEN=                  # optional secret; the bot that sends the Telegram message of an alert; unset = Telegram sends fail with "Telegram is not configured."
ALERTS_EMAIL_TO=                     # optional; comma-separated addresses that get the email of every alert, e.g. ops@example.com,oncall@example.com; unset = the email of an alert is recorded as failed ("No alert recipient is configured for email.")
ALERTS_TELEGRAM_CHAT_ID=              # optional; the ops Telegram chat that gets the Telegram message of every alert (a chat id such as -1001234567890, or @channelname); unset = recorded as failed

# --- Storefront anti-bot check (decision 034: Cloudflare Turnstile on the public storefront writes) ----------------
TURNSTILE_SECRET_KEY=                # REQUIRED in production; the widget's secret. Unset in development/test = the dummy verifier, which accepts only the token XXXX.DUMMY.TOKEN.XXXX (Cloudflare's test sitekey 1x00000000000000000000AA produces it)
TURNSTILE_HOSTNAMES=                 # optional; comma-separated host names a token may be issued for, e.g. shop.example.com; unset = any
TURNSTILE_MERCHANT_AUTH=false        # default off outside production, on in production (decision 052); true also requires the token on POST /client/auth/login and /password/forgot (feature 24A); false switches it off

# --- Live event streams (decision 037: GET /admin/stream, /client/stream, /store/v1/me/stream; SSE) -------------------
REALTIME_ENABLED=true                # false = kill switch: every stream answers 503 and the clients keep polling
REALTIME_MAX_CONNECTIONS=5000        # open streams per API process (1-100000); the next one is 503 UNAVAILABLE
REALTIME_MAX_PER_SESSION=3           # open streams per session (1-50); the newest is refused with 429
REALTIME_MAX_PER_IP=30               # open streams per client address (1-100000); the newest is refused with 429
REALTIME_HEARTBEAT_SECONDS=15        # hb event interval (5-25); must stay under the 30 s silence cut of a Next rewrite
REALTIME_MAX_AGE_SECONDS=900         # a stream ends after this (60-3600, plus 0-120 s jitter) and reconnects through the guard

# --- Storefront search (feature 29, decision 038: Typesense holds derived, public, price-free documents) ------------------
SEARCH_ENABLED=true                  # false = every search is the Postgres fallback and the sync jobs complete without calls (no deploy needed)
SEARCH_ENABLED_TEST=false            # NODE_ENV=test: search stays on ILIKE unless a suite opts in (test/support/search.ts)
TYPESENSE_URL=http://localhost:8108  # REQUIRED in production while SEARCH_ENABLED (http://typesense:8108); the node of compose.yaml in development
TYPESENSE_URL_TEST=http://localhost:8108   # NODE_ENV=test: the node the search suites use (a worktree's .env.test may set it)
TYPESENSE_INDEXER_KEY=gsm-typesense-dev   # secret; the worker's key (bun scripts/search-keys.ts creates it); production: required in the worker, refuses this development value
TYPESENSE_SEARCH_KEY=gsm-typesense-dev    # secret; the API's key (search, aliases:get, collections:get only); production: required in the API, refuses this development value
TYPESENSE_PREFIX=gsm_development_    # start of every collection, alias and set name (^[a-z0-9_]{1,40}_$); production gsm_production_
TYPESENSE_PREFIX_TEST=               # NODE_ENV=test; default: the database name of DATABASE_URL_TEST and "_" (gsm_29_test_), so worktrees never meet
SEARCH_SUGGEST_TIMEOUT_MS=250        # one suggest call to the engine (50-2000); on a timeout the suggest answers from the fallback
SEARCH_TIMEOUT_MS=800                # one results-page call to the engine (100-5000)
SEARCH_RECONCILE_MINUTES=15          # how often the worker compares the index with Postgres (5-1440)

# --- Tooling (not read by the app): frontend repo, read-only input for the contract tests and the route manifest. --
FRONTEND_DIR=../frontend-admin
