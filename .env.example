# Every variable the backend reads (src/config/env.ts, decision 013). Copy to .env and adjust. Never commit real secrets.
# Local defaults match compose.yaml (`docker compose up -d`); outside production every value below is optional.
# In production the values marked REQUIRED must be set, and the development secrets (CSRF_SECRET, TOKEN_PEPPER and the
# ENCRYPTION_KEYS dev key) are refused.
# Bun loads .env, .env.<NODE_ENV> and .env.local itself; tests set NODE_ENV=test.

# --- Process and HTTP ---------------------------------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=3000                            # API port
HOST=0.0.0.0                         # API bind address
LOG_LEVEL=                           # fatal|error|warn|info|debug|trace|silent; default info (prod), debug (dev), warn (test)
TRUST_PROXY=                         # empty/false = trust none; a hop count (1-10) or a list "10.0.0.0/8,loopback"
BODY_LIMIT_BYTES=1048576             # largest JSON body (uploads use their own limits)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # exact origins, comma separated; empty = no cross-origin access
ERRORS_BASE_URL=http://localhost:3000/errors               # REQUIRED in production; base of the problem+json "type" URI
REFERENCE_DOCS=                      # internal API reference (GET /reference): open | staff | off; default open (dev/test), staff (production); staff needs a staff session with system:read (401/403 otherwise)

# --- Postgres (decision 005). Integration and scenario tests use DATABASE_URL_TEST. ------------------------------
DATABASE_URL=postgres://gsm:gsm@localhost:5432/gsm            # REQUIRED in production
DATABASE_URL_TEST=postgres://gsm:gsm@localhost:5432/gsm_test
DATABASE_POOL_MAX=10

# --- Two Redis roles (decision 006): BullMQ only on the queue instance, cache/rate limits/locks on the cache one. ---
REDIS_QUEUE_URL=redis://localhost:6379/0                      # REQUIRED in production
REDIS_CACHE_URL=redis://localhost:6380/0                      # REQUIRED in production
BULL_PREFIX=                         # default gsm:<env>:bull; the prefix of every BullMQ key (docs/queues.md)
REDIS_QUEUE_URL_TEST=                # NODE_ENV=test only (the two URLs above are ignored then); default redis://localhost:6379/1
REDIS_CACHE_URL_TEST=                # NODE_ENV=test only; default redis://localhost:6380/1

# --- S3-compatible storage (decision 004); local MinIO from compose.yaml. -----------------------------------------
S3_ENDPOINT=http://localhost:9000    # empty = local MinIO outside production, AWS default endpoint in production
S3_REGION=us-east-1
S3_BUCKET=gsm-files                  # REQUIRED in production
S3_BUCKET_TEST=                      # NODE_ENV=test only (S3_BUCKET is ignored then); default gsm-files-test
S3_ACCESS_KEY_ID=gsm-minio           # REQUIRED in production
S3_SECRET_ACCESS_KEY=gsm-minio-secret                         # REQUIRED in production
S3_FORCE_PATH_STYLE=true             # true for MinIO, false for AWS

# --- Sessions, CSRF and encryption (decisions 018, 019). All REQUIRED in production, never the dev defaults. ---------
CSRF_SECRET=                         # REQUIRED in production; >= 32 characters; HMAC key of the CSRF token
CSRF_COOKIE_DOMAIN=                  # Domain of the readable csrf_token cookie (cross-subdomain consoles)
COOKIE_SECURE=                       # true in production (required there); false allowed for http://localhost
TOKEN_PEPPER=                        # REQUIRED in production; >= 32 characters; HMAC key for session/API-key hashes (rotating it signs everyone out)
ENCRYPTION_KEYS=                     # REQUIRED in production; "<kid>:<base64 of 32 bytes>[,<kid>:<key>...]", e.g. generate with `openssl rand -base64 32`
ENCRYPTION_ACTIVE_KID=               # REQUIRED in production; key id (from ENCRYPTION_KEYS) used for new encryptions
ARGON2_MEMORY_KIB=19456              # argon2id memory per password hash, in KiB (OWASP baseline: 19456 with time cost 2, parallelism 1)
ARGON2_TIME_COST=2                   # argon2id passes; tune the three values with `bun run bench:argon2` to 50-150 ms per hash on the target host
ARGON2_PARALLELISM=1                 # argon2id lanes; the memory must be at least 8 KiB per lane

# --- Observability (decision 015) -----------------------------------------------------------------------------------
METRICS_TOKEN=                       # REQUIRED in production; >= 16 characters; when set, /metrics needs "Authorization: Bearer <token>" from everyone; unset = loopback/private callers only
WORKER_METRICS_PORT=9464             # the worker's own /metrics listener
PROMETHEUS_URL=http://localhost:9090  # the Prometheus of compose.yaml (System health history); in production its internal URL; unset = MONITORING_UNAVAILABLE
SENTRY_DSN=                          # optional; unexpected 5xx only

# --- Tooling (not read by the app): frontend repo, read-only input for the contract tests and the route manifest. --
FRONTEND_DIR=../frontend-admin
