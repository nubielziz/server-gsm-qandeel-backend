# Local defaults match compose.yaml (`docker compose up -d`). Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres (decision 005). Integration and scenario tests use the gsm_test database.
DATABASE_URL=postgres://gsm:gsm@localhost:5432/gsm
DATABASE_URL_TEST=postgres://gsm:gsm@localhost:5432/gsm_test

# Two Redis roles (decision 006): BullMQ only on the queue instance, cache/rate limits/locks on the cache instance.
REDIS_QUEUE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0

# S3-compatible storage (decision 004); local MinIO from compose.yaml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gsm-files
S3_ACCESS_KEY_ID=gsm-minio
S3_SECRET_ACCESS_KEY=gsm-minio-secret
S3_FORCE_PATH_STYLE=true

# Frontend repo (read-only input for the contract tests and the route manifest).
FRONTEND_DIR=../frontend-admin
