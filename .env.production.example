# The application's variables in production (feature 24D, decision 036). Copy to .env.production (git-ignored) and replace every
# placeholder value (each starts with the word CHANGE) and every example.com host. The API, the worker and the migrate/setup tools all read this one file through
# deploy/compose.prod.yaml. Compose-level values (hosts for Caddy, image names, Postgres, Redis and MinIO passwords) are in deploy/.env.
# `DATABASE_OWNER_URL` is not here: the compose file gives it to the migrate service only (decision 055).
# Variables the image sets itself (PORT, APP_VERSION, GIT_SHA) are not listed. Reference: .env.example and src/config/env.ts.
# A secret in this file is never committed, never echoed in a log (pino redaction), never reused from development.

NODE_ENV=production
COOKIE_SECURE=true                   # session cookies are Secure; production refuses false

# --- Network: Caddy is the only way in (docs/OPERATIONS.md section 1) ---------------------------------------------------------
TRUST_PROXY=172.30.1.2,172.30.1.3     # exactly Caddy and the site: their fixed addresses in deploy/compose.prod.yaml (decision 055); production requires it
PORTAL_BASE_URL=https://shop.example.com/merchant   # merchant invitation links: <PORTAL_BASE_URL>/set-password?token=...
STORE_BASE_URL=https://shop.example.com             # customer links: <STORE_BASE_URL>/sign-in?token=...
ERRORS_BASE_URL=https://api.example.com/errors      # base of the problem+json "type" URI (API_HOST)
# HTTP_HEADERS_TIMEOUT_MS=20000      # the headers of a request must arrive within this (100-120000); the default is safe
# HTTP_REQUEST_TIMEOUT_MS=600000     # the whole request, body included (1000-3600000); a 25 MiB upload needs about 0.35 Mbit/s
REFERENCE_DOCS=staff                 # GET /reference needs a staff session with system:read
TURNSTILE_HOSTNAMES=shop.example.com # SHOP_HOST: the host names a Turnstile token may be issued for
CONSOLE_BASE_URL=https://admin.example.com     # ADMIN_HOST: staff invitation and reset links are <CONSOLE_BASE_URL>/set-password?token=...
# The browser origins the API trusts come from the three base URLs above (decision 045): CONSOLE_BASE_URL's on /admin and /reference,
# STORE_BASE_URL's and PORTAL_BASE_URL's on /client and /store/v1. Every base URL is https; CORS_ORIGINS is refused.

# --- Postgres and the two Redis roles (decisions 005, 006): the service names of deploy/compose.prod.yaml ------------------------
DATABASE_URL=postgres://gsm_app:CHANGE_ME_APP_DB_PASSWORD@postgres:5432/gsm   # the application's own role (decision 055): db:migrate creates it with this password (letters and digits, at least 16); never the owner gsm
DATABASE_POOL_MAX=10                 # per process (api and worker each hold one pool); Postgres allows 200 connections
REDIS_QUEUE_URL=redis://:CHANGE_ME_REDIS_QUEUE_PASSWORD@redis-queue:6379/0   # the password is REDIS_QUEUE_PASSWORD of deploy/.env
REDIS_CACHE_URL=redis://:CHANGE_ME_REDIS_CACHE_PASSWORD@redis-cache:6379/0   # the password is REDIS_CACHE_PASSWORD of deploy/.env
TYPESENSE_URL=http://typesense:8108  # the search engine (feature 29); each container gets only its own key (TYPESENSE_SEARCH_KEY / TYPESENSE_INDEXER_KEY)

# --- Files: the bundled MinIO (decision 004). For an external S3 remove S3_ENDPOINT's host, set the provider's values and S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=gsm-files
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_APP_USER       # MINIO_APP_USER of deploy/.env: the application's own MinIO user, never the root account (decision 055)
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_APP_PASSWORD   # MINIO_APP_PASSWORD of deploy/.env (at least 16 characters)
S3_PUBLIC_ENDPOINT=https://files.example.com    # https://<FILES_HOST of deploy/.env>: file links are signed for this address (decision 055)

# --- Secrets: make each one with the command shown; keep two offline copies (docs/OPERATIONS.md section 5) -------------------------
ENCRYPTION_KEYS=CHANGE_ME_ENCRYPTION_KEYS   # "<kid>:<base64 of 32 bytes>", e.g. k1: followed by the output of openssl rand -base64 32. Losing it makes TOTP secrets and supplier/gateway credentials unreadable
ENCRYPTION_ACTIVE_KID=k1                    # the key id (from ENCRYPTION_KEYS) used for new encryptions
CSRF_SECRET=CHANGE_ME_CSRF_SECRET           # openssl rand -hex 32 (>= 32 characters)
TOKEN_PEPPER=CHANGE_ME_TOKEN_PEPPER         # openssl rand -hex 32 (>= 32 characters); rotating it signs everyone out and voids API keys and open links
LOOKUP_HASH_KEY=CHANGE_ME_LOOKUP_HASH_KEY   # openssl rand -hex 32 on a new installation; on one that already has data, the value of its current TOKEN_PEPPER, so the blocklist and the other stored lookups keep matching (docs/OPERATIONS.md section 5). Never change it afterwards
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN       # openssl rand -hex 32 (at least 32 characters in production); the same value, without a newline, goes into deploy/secrets/metrics_token for Prometheus
PROMETHEUS_URL=http://prometheus:9090       # System health history reads Prometheus inside the network

# --- Mail (decision 033): verify the sending domain first (docs/OPERATIONS.md section 7) ---------------------------------------
MAIL_SMTP_URL=smtps://CHANGE_ME_SMTP_USER:CHANGE_ME_SMTP_PASSWORD@smtp.example.com:465   # a secret; URL-encode special characters in the password
MAIL_FROM=GSM <noreply@example.com>         # an address on the verified domain (SPF, DKIM, DMARC)

# --- Storefront anti-bot check (decision 034) -----------------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET   # the secret of the Cloudflare Turnstile widget for SHOP_HOST
TURNSTILE_MERCHANT_AUTH=true                 # the merchant sign-up, sign-in and forgot forms need the anti-bot token (the default in production; false switches it off)

# --- Exchange rates (decisions 029, 049) ------------------------------------------------------------------------------------------
FX_PROVIDER=openexchangerates        # or manual: rates are typed on the Currencies page; a rate older than 48 hours (fx.max_rate_age_hours) is then not offered at checkout until staff confirm it
FX_API_KEY=CHANGE_ME_FX_API_KEY      # the openexchangerates app id (a secret); production refuses openexchangerates without it. With FX_PROVIDER=manual remove this line

# --- Optional: remove the leading "# " to use ------------------------------------------------------------------------------------
# CONSOLE_ORIGINS=https://admin.example.com   # replaces the list derived from CONSOLE_BASE_URL, so it must include that origin; leave unset unless another origin must be trusted (https only)
# SHOP_ORIGINS=https://shop.example.com       # replaces the list derived from STORE_BASE_URL and PORTAL_BASE_URL, so it must include both origins; leave unset unless another origin must be trusted (https only)
# LOG_LEVEL=info
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=   # then: bun scripts/telegram-webhook.ts (docs/OPERATIONS.md section 6)
# ALERTS_EMAIL_TO=ops@example.com
# ALERTS_TELEGRAM_CHAT_ID=
# GEOIP_COUNTRY_HEADER=            # set in deploy/.env instead (compose passes it to the API and to Caddy); only with a CDN in front (docs/OPERATIONS.md, Visitor country)
# SENTRY_DSN=                      # errors only, scrubbed of personal data; unset = nothing is sent (docs/OPERATIONS.md section 6)
