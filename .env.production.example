# The application's variables in production (feature 24D, decision 036). Copy to .env.production (git-ignored) and replace every
# CHANGE_ME and every example.com host. The API, the worker and the migrate/setup tools all read this one file through
# deploy/compose.prod.yaml. Compose-level values (hosts for Caddy, image names, Postgres and MinIO passwords) are in deploy/.env.
# Variables the image sets itself (PORT, APP_VERSION, GIT_SHA) are not listed. Reference: .env.example and src/config/env.ts.
# A secret in this file is never committed, never echoed in a log (pino redaction), never reused from development.

NODE_ENV=production
COOKIE_SECURE=true                   # session cookies are Secure; production refuses false

# --- Network: Caddy is the only way in (docs/OPERATIONS.md section 1) ---------------------------------------------------------
TRUST_PROXY=172.30.0.0/24            # exactly the compose subnet of deploy/compose.prod.yaml: Caddy's address, no hop count
CORS_ORIGINS=https://shop.example.com,https://admin.example.com   # the browser origins (SHOP_HOST, ADMIN_HOST), also when same-origin: the Origin check of public POSTs needs them
PORTAL_BASE_URL=https://shop.example.com/merchant   # merchant invitation links: <PORTAL_BASE_URL>/set-password?token=...
STORE_BASE_URL=https://shop.example.com             # customer links: <STORE_BASE_URL>/sign-in?token=...
ERRORS_BASE_URL=https://api.example.com/errors      # base of the problem+json "type" URI (API_HOST)
REFERENCE_DOCS=staff                 # GET /reference needs a staff session with system:read
TURNSTILE_HOSTNAMES=shop.example.com # SHOP_HOST: the host names a Turnstile token may be issued for
CONSOLE_BASE_URL=https://admin.example.com     # ADMIN_HOST: staff invitation and reset links are <CONSOLE_BASE_URL>/set-password?token=...

# --- Postgres and the two Redis roles (decisions 005, 006): the service names of deploy/compose.prod.yaml ------------------------
DATABASE_URL=postgres://gsm:CHANGE_ME_POSTGRES@postgres:5432/gsm   # the password is POSTGRES_PASSWORD of deploy/.env (letters and digits only)
DATABASE_POOL_MAX=10                 # per process (api and worker each hold one pool); Postgres allows 200 connections
REDIS_QUEUE_URL=redis://redis-queue:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0
TYPESENSE_URL=http://typesense:8108  # the search engine (feature 29); each container gets only its own key (TYPESENSE_SEARCH_KEY / TYPESENSE_INDEXER_KEY)

# --- Files: the bundled MinIO (decision 004). For an external S3 remove S3_ENDPOINT's host, set the provider's values and S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=gsm-files
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER           # MINIO_ROOT_USER of deploy/.env
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD   # MINIO_ROOT_PASSWORD of deploy/.env

# --- Secrets: make each one with the command shown; keep two offline copies (docs/OPERATIONS.md section 5) -------------------------
ENCRYPTION_KEYS=CHANGE_ME_ENCRYPTION_KEYS   # "<kid>:<base64 of 32 bytes>", e.g. k1: followed by the output of openssl rand -base64 32. Losing it makes TOTP secrets and supplier/gateway credentials unreadable
ENCRYPTION_ACTIVE_KID=k1                    # the key id (from ENCRYPTION_KEYS) used for new encryptions
CSRF_SECRET=CHANGE_ME_CSRF_SECRET           # openssl rand -hex 32 (>= 32 characters)
TOKEN_PEPPER=CHANGE_ME_TOKEN_PEPPER         # openssl rand -hex 32 (>= 32 characters); rotating it signs everyone out and voids API keys
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN       # openssl rand -hex 32; the same value, without a newline, goes into deploy/secrets/metrics_token for Prometheus
PROMETHEUS_URL=http://prometheus:9090       # System health history reads Prometheus inside the network

# --- Mail (decision 033): verify the sending domain first (docs/OPERATIONS.md section 7) ---------------------------------------
MAIL_SMTP_URL=smtps://CHANGE_ME_SMTP_USER:CHANGE_ME_SMTP_PASSWORD@smtp.example.com:465   # a secret; URL-encode special characters in the password
MAIL_FROM=GSM <noreply@example.com>         # an address on the verified domain (SPF, DKIM, DMARC)

# --- Storefront anti-bot check (decision 034) -----------------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET   # the secret of the Cloudflare Turnstile widget for SHOP_HOST

# --- Optional: remove the leading "# " to use ------------------------------------------------------------------------------------
# LOG_LEVEL=info
# FX_PROVIDER=openexchangerates
# FX_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# ALERTS_EMAIL_TO=ops@example.com
# ALERTS_TELEGRAM_CHAT_ID=
# GEOIP_COUNTRY_HEADER=            # only if a trusted CDN in front of Caddy sets the visitor's country
# SENTRY_DSN=                      # errors only, scrubbed of personal data; unset = nothing is sent (docs/OPERATIONS.md section 6)
