# Secrets and local env
.env
.env.*
!.env.example

# Dependencies and build or test output
/node_modules
/dist
/coverage
/tmp
/*.tsbuildinfo

# Serena caches (project.yml and memories are committed)
/.serena/cache
/.serena/project.local.yml

# Spike migration output (regenerated by `bun run spike`)
/spike/**/drizzle/

# IDEs and OS files
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
