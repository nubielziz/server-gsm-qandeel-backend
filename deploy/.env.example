# Compose-level values of the production stack (feature 24D, decision 036). Copy to deploy/.env (git-ignored) and replace every
# placeholder value (each starts with the word CHANGE). The application's own variables are in .env.production (template: .env.production.example), not here.
# Passwords: letters and digits only (they go into connection URLs); openssl rand -hex 24 makes one.

# --- Hosts: three DNS names pointing at this server (Caddy gets a certificate for each) --------------------------------------
SHOP_HOST=shop.example.com           # the storefront and the merchant portal; /client/* and /store/v1/* go to the API (the API trusts this host's pages on these paths only, decision 045)
ADMIN_HOST=admin.example.com         # the admin console; /admin/*, /health, /reference and /store/v1/media/* go to the API (the API trusts this host's pages on /admin and /reference only, decision 045)
API_HOST=api.example.com             # machine clients only: Dhru (/api/index.php), REST v1 (/v1/*), webhooks (/webhooks/*), /docs
FILES_HOST=files.example.com         # signed file downloads (decision 055): Caddy passes only signed reads of the files bucket to MinIO; S3_PUBLIC_ENDPOINT of .env.production is https://<FILES_HOST>
ACME_EMAIL=ops@example.com           # Let's Encrypt account address (expiry notices)

# --- Images (built on the server or pulled from a registry; docs/OPERATIONS.md section 2) ----------------------------------
BACKEND_IMAGE=gsm-backend:local      # api, worker and migrate
CONSOLE_IMAGE=gsm-console:local      # built from frontend-admin/Dockerfile with VITE_API_BASE_URL=""
SITE_IMAGE=gsm-site:local            # the storefront (profile `site`); not available until the storefront ships its image
GIT_SHA=unknown                      # build args of BACKEND_IMAGE: shown on the System health Overview
APP_VERSION=0.0.0

# --- Passwords of the bundled services ---------------------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES   # the owner role gsm: migrate, setup, the backups and you (decision 055); the application has its own role (DATABASE_URL of .env.production)
REDIS_QUEUE_PASSWORD=CHANGE_ME_REDIS_QUEUE   # the same value goes into REDIS_QUEUE_URL of .env.production
REDIS_CACHE_PASSWORD=CHANGE_ME_REDIS_CACHE   # the same value goes into REDIS_CACHE_URL of .env.production
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER   # the MinIO containers and the minio-admin tool only (decision 055)
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD   # the MinIO containers and the minio-admin tool only (decision 055); openssl rand -hex 24
MINIO_APP_USER=CHANGE_ME_MINIO_APP_USER   # the application's MinIO user (policy gsm-app); the same value goes into S3_ACCESS_KEY_ID of .env.production
MINIO_APP_PASSWORD=CHANGE_ME_MINIO_APP_PASSWORD   # at least 16 characters; S3_SECRET_ACCESS_KEY of .env.production
MINIO_BACKUP_USER=CHANGE_ME_MINIO_BACKUP_USER   # the backups' read-only MinIO user (policy gsm-backup-read)
MINIO_BACKUP_PASSWORD=CHANGE_ME_MINIO_BACKUP_PASSWORD   # at least 16 characters
# REDIS_QUEUE_MAXMEMORY=512mb   # the queue Redis refuses new jobs beyond this (noeviction); keep it under REDIS_QUEUE_MEM_LIMIT
# REDIS_QUEUE_MEM_LIMIT=1g

# --- Search engine (feature 29, docs/OPERATIONS.md section 6): three secrets, each a long random value (openssl rand -hex 32) -------
TYPESENSE_BOOTSTRAP_KEY=CHANGE_ME_TYPESENSE_BOOTSTRAP   # the engine's own admin key: only the typesense container and you hold it; used by scripts/search-keys.ts
TYPESENSE_INDEXER_KEY=CHANGE_ME_TYPESENSE_INDEXER       # the worker's key (writes documents and sets), limited to this environment's names
TYPESENSE_SEARCH_KEY=CHANGE_ME_TYPESENSE_SEARCH         # the API's key (search and alias reads only)
# TYPESENSE_MEM_LIMIT=1536m          # container memory: 1.5 GB holds about 100 000 services; raise it before the index grows past that

# --- Visitor country (decision 050, docs/OPERATIONS.md section 1 "Visitor country"): only with a CDN in front of Caddy -----------
# GEOIP_COUNTRY_HEADER=CF-IPCountry   # the header the CDN writes; the API reads the visitor's country from it, Caddy removes it from visitors' requests

# --- Backups (docs/OPERATIONS.md section 4): an S3-compatible bucket on ANOTHER provider or account than the server ---------
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=gsm-backups
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME_BACKUP_KEY_ID   # this key may list, read and write in the bucket, never delete (docs/OPERATIONS.md section 4)
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME_BACKUP_SECRET
BACKUP_AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_KEY   # "age1..." from `age-keygen`; the private key never stays on this server
BACKUP_RETENTION_DAYS=30             # daily dumps kept: the lifecycle rule of the bucket decides; the script prunes by it only with BACKUP_PRUNE=1
BACKUP_MONTHLY_KEEP=12               # monthly dumps kept (with BACKUP_PRUNE=1 only, like the line above)
# BACKUP_PRUNE=0   # 1 only for a provider without lifecycle rules: then this key must be allowed to delete (docs/OPERATIONS.md section 4)
# BACKUP_S3_REGION=            # the provider's region, when it needs one
# BACKUP_S3_PROVIDER=Other     # the rclone provider name (AWS, Cloudflare, Wasabi, Other ...)
# BACKUP_ALLOW_PLAINTEXT=0     # 1 lets the scripts store dumps and files without encryption (never in production)
