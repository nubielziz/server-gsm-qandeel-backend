# Reverse proxy of the production stack (feature 24D, decisions 036 and 055, docs/OPERATIONS.md). One browser origin per audience:
#   SHOP_HOST   the storefront (container `site`); /client/* and /store/v1/* go straight to the API, so there is no CORS
#   ADMIN_HOST  the console (container `console`); /admin/*, /health, the internal reference and the pictures under /store/v1/media/*
#               (the console's listing pictures and payment logos load on its own origin) go to the API
#   API_HOST    machine clients only: Dhru, REST v1, incoming webhooks and the public docs; every other path is a 404
#   FILES_HOST  signed file downloads only: reads of the files bucket that carry a signature go to MinIO, everything else is a 404
#               (decision 055)
# /metrics matches no route on any host. Caddy sets X-Forwarded-For itself (it drops a client-sent value), and the API trusts
# exactly Caddy's and the site's fixed addresses (TRUST_PROXY=172.30.1.2,172.30.1.3, decision 055). Do not add `trusted_proxies`
# unless a CDN is placed in front.
# The console's and the shop's pages get the anti-framing, nosniff and referrer headers of decision 045; the API's answers keep the
# API's own headers.
# Every host removes the visitor-country header (GEOIP_COUNTRY_HEADER) before the API: this edge writes no country, so no visitor can
# choose the one the API reads (decision 050).
# Every host writes the same access log (decision 054): the token part of the shop's link addresses, the Telegram webhook path, link
# tokens, searches and IMEIs in the query, and credential headers are not written.
{
	email {$ACME_EMAIL}
	# Decision 055: a client that is slow to send its headers or that stalls an upload is cut; the live streams write at least every 15 s.
	servers {
		timeouts {
			read_header 10s
			read_body_idle 30s
			write_idle 1m
			idle 2m
		}
	}
}

(common) {
	# Live event streams (decision 037) are never compressed: `encode` matches text/* and would put an encoder on every long-lived
	# connection, which delays the small frames. Caddy flushes a text/event-stream answer at once by itself, so there is no
	# `flush_interval`: an explicit `-1` would also stop Caddy from cancelling the upstream request when the browser leaves, and
	# the API needs that close to free the stream. The fourth path is the ticket stream of the support chat (feature 28).
	@compressible not path /store/v1/me/stream /client/stream /admin/stream /store/v1/tickets/*/stream
	encode @compressible zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# The API's largest upload is 25 MiB plus form fields.
	request_body {
		max_size 27MB
	}
}

# The access log of every host (decision 054). Caddy writes the request address, the Referer and the headers of each request and answer.
# Here the token part of the shop's link pages and of their API routes, the Telegram webhook path, and the values of the query parameters
# that carry a link token, a typed search or an IMEI are replaced, in the address and in the Referer alike; the headers that carry a
# credential are not written (Caddy itself hides Cookie, Set-Cookie, Authorization and Proxy-Authorization), nor the two headers in which
# the shop's pages send their own address with every prefetch, refresh and navigation (Next-Url, Next-Router-State-Tree). A redirect's
# Location gets the same path rules and loses its whole query string (a signed download link). One multi_regexp per field holds every
# rule, one regexp line each. The API logs route templates only. Every site block imports this snippet. The signature parameters of a
# file link (X-Amz-...) are replaced in the address and in the Referer too (decision 055), and so are the values of its response-content-*
# parameters, which carry the stored file's name. The answer's Content-Disposition, which names the file as well, is not written.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			request>uri multi_regexp {
				regexp "/store/v1/orders/[^/?#]+" "/store/v1/orders/[token]"
				regexp "/checkout-sessions/[^/?#]+" "/checkout-sessions/[token]"
				regexp "/tickets/[^/?#]+" "/tickets/[token]"
				regexp "/unsubscribe/[^/?#]+" "/unsubscribe/[token]"
				regexp "/track/[^/?#]+" "/track/[token]"
				regexp "/checkout/[^/?#]{16,}" "/checkout/[token]"
				regexp "/webhooks/telegram/[^/?#]+" "/webhooks/telegram/[secret]"
				regexp "([?&])(token|q|order|next|imei|apiaccesskey)=[^&#]*" "${1}${2}=[redacted]"
				regexp "([?&])(X-Amz-[A-Za-z-]+)=[^&#]*" "${1}${2}=[redacted]"
				regexp "([?&])(response-content-[A-Za-z-]+)=[^&#]*" "${1}${2}=[redacted]"
			}
			request>headers>Referer multi_regexp {
				regexp "/store/v1/orders/[^/?#]+" "/store/v1/orders/[token]"
				regexp "/checkout-sessions/[^/?#]+" "/checkout-sessions/[token]"
				regexp "/tickets/[^/?#]+" "/tickets/[token]"
				regexp "/unsubscribe/[^/?#]+" "/unsubscribe/[token]"
				regexp "/track/[^/?#]+" "/track/[token]"
				regexp "/checkout/[^/?#]{16,}" "/checkout/[token]"
				regexp "/webhooks/telegram/[^/?#]+" "/webhooks/telegram/[secret]"
				regexp "([?&])(token|q|order|next|imei|apiaccesskey)=[^&#]*" "${1}${2}=[redacted]"
				regexp "([?&])(X-Amz-[A-Za-z-]+)=[^&#]*" "${1}${2}=[redacted]"
				regexp "([?&])(response-content-[A-Za-z-]+)=[^&#]*" "${1}${2}=[redacted]"
			}
			request>headers>X-Csrf-Token delete
			request>headers>X-Turnstile-Token delete
			request>headers>Idempotency-Key delete
			request>headers>X-Telegram-Bot-Api-Secret-Token delete
			request>headers>Stripe-Signature delete
			request>headers>X-Gsm-Signature delete
			request>headers>Next-Url delete
			request>headers>Next-Router-State-Tree delete
			resp_headers>X-Csrf-Token delete
			resp_headers>Content-Disposition delete
			resp_headers>Location multi_regexp {
				regexp "/store/v1/orders/[^/?#]+" "/store/v1/orders/[token]"
				regexp "/checkout-sessions/[^/?#]+" "/checkout-sessions/[token]"
				regexp "/tickets/[^/?#]+" "/tickets/[token]"
				regexp "/unsubscribe/[^/?#]+" "/unsubscribe/[token]"
				regexp "/track/[^/?#]+" "/track/[token]"
				regexp "/checkout/[^/?#]{16,}" "/checkout/[token]"
				regexp "/webhooks/telegram/[^/?#]+" "/webhooks/telegram/[secret]"
				regexp "[?].*" "?[redacted]"
			}
		}
	}
}

# Headers of the console's own pages (decision 045): no site may frame them, no MIME sniffing, no address of a console page sent to
# another site. Imported on the console's handle only: the API's answers keep the stricter headers the API sets itself. No script
# policy here: the console's page runs an inline script, and its policy is the console's to write.
(console_page_headers) {
	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		defer
	}
}

# Headers of the storefront's and the merchant portal's pages (decision 045). The site may send a policy of its own (its script
# policy is the storefront's to write): the edge adds its anti-framing policy as a second one, and both apply. The site's
# X-Frame-Options and nosniff are replaced by one value each; its Referrer-Policy is kept, with a default when it sends none.
(shop_page_headers) {
	header {
		+Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		defer
	}
	header ?Referrer-Policy "strict-origin-when-cross-origin"
}

{$SHOP_HOST} {
	import common
	import access_log
	# Decision 050: removed at the top of the host, before any route, so it holds for the requests that go straight to the API and for
	# those the site's own server forwards. With a CDN in front, keep it only from the CDN's addresses (docs/OPERATIONS.md, Visitor country).
	request_header -{$GEOIP_COUNTRY_HEADER:X-Visitor-Country}
	@api path /client/* /store/v1/*
	handle @api {
		reverse_proxy api:3000
	}
	handle {
		import shop_page_headers
		reverse_proxy site:3000
	}
}

{$ADMIN_HOST} {
	import common
	import access_log
	# Decision 050: see the shop host.
	request_header -{$GEOIP_COUNTRY_HEADER:X-Visitor-Country}
	@api path /admin/* /health /reference /reference/* /store/v1/media/*
	handle @api {
		reverse_proxy api:3000
	}
	handle {
		import console_page_headers
		reverse_proxy console:80
	}
}

{$API_HOST} {
	import common
	import access_log
	# Decision 050: see the shop host.
	request_header -{$GEOIP_COUNTRY_HEADER:X-Visitor-Country}
	@api path /api/index.php /v1/* /webhooks/* /docs /docs/*
	handle @api {
		reverse_proxy api:3000
	}
	handle {
		respond 404
	}
}

# Signed file downloads (decision 055): the API's file routes answer 302 to a short-lived link of this host. Only reads of one object of
# the files bucket that carry a signature reach MinIO, with the Host unchanged (the signature covers it); the bucket itself, a listing
# and every other method or path are a 404. The path is what a stored object's name can be: the storage layer's own rule for a key
# (src/infra/storage/storage-names.ts), where every segment starts with a letter or a digit. Caddy resolves `.` and `..` segments
# before `path_regexp` sees a path and passes the path on as it was sent, so the same rule is checked a second time against the path as
# it was sent, after its percent escapes are decoded (`vars_regexp`): a path with a `.` or `..` segment is not passed on. The answers
# are attachments, and the policy below keeps any content from running on this host.
{$FILES_HOST} {
	import common
	import access_log
	@signed_read {
		method GET HEAD
		path_regexp ^/gsm-files/[A-Za-z0-9][A-Za-z0-9._=+-]*(/[A-Za-z0-9][A-Za-z0-9._=+-]*)*$
		vars_regexp raw_path {http.request.uri.path} ^/gsm-files/[A-Za-z0-9][A-Za-z0-9._=+-]*(/[A-Za-z0-9][A-Za-z0-9._=+-]*)*$
		query X-Amz-Signature=*
		query response-content-disposition=*
	}
	handle @signed_read {
		header {
			Content-Security-Policy "default-src 'none'; sandbox"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			defer
		}
		reverse_proxy minio:9000 {
			header_up Host {hostport}
		}
	}
	handle {
		respond 404
	}
}
