    {
      "id": "system-alert",
      "nameAr": "تنبيه وحادثة: مورد يتباطأ",
      "group": "ops",
      "steps": [
        {
          "step": 1,
          "from": "worker",
          "to": "db",
          "label": "فحص دوري",
          "textAr": "كل دقيقة يفحص الـ Worker قاعدة البيانات والكاش والتخزين وبوابات الدفع وكل مورد (accountinfo)، ويكتب في service_checks الحالة وزمن الاستجابة. منها تُحسب نسبة التشغيل، ولا تُخزَّن فيها مقاييس عالية الدقة.",
          "tables": [
            "service_checks",
            "suppliers"
          ]
        },
        {
          "step": 3,
          "from": "worker",
          "to": "db",
          "label": "تقييم القواعد",
          "textAr": "كل دقيقة تُقيَّم قواعد alert_rules على آخر نافذة. نسبة مهلات المورد فوق 20% لثلاث دقائق تنشئ alert_events بحالة firing وموضوعها المورد، إلا إن كانت القاعدة مكتومة بـ muted_until.",
          "tables": [
            "alert_rules",
            "alert_events",
            "service_checks"
          ]
        },
        {
