{
  "name": "gsm-backend",
  "version": "0.1.0",
  "description": "GSM supplier backend: order engine, supplier layer and double-entry ledger behind the Dhru, REST v1, client portal, storefront and admin APIs.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start:worker": "bun src/worker.ts",
    "dev:worker": "bun --watch src/worker.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test": "bun test --timeout 15000 ./src ./test",
    "test:unit": "bun test --timeout 15000 ./src",
    "test:integration": "bun test --timeout 15000 ./test/integration",
    "routes:build": "bun scripts/build-route-manifest.mjs && bun scripts/build-route-slices.mjs",
    "routes:check": "bun scripts/build-route-manifest.mjs --check && bun scripts/build-route-slices.mjs --check",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:check": "bun scripts/db-check.ts",
    "db:seed": "bun scripts/seed/index.ts",
    "bench:argon2": "bun scripts/bench-argon2.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run routes:check && bun run contract:check && bun run docs:openapi:check && bun run coverage:check && bun run db:check && bun run test",
    "contract:extract": "bun scripts/extract-frontend-contract.mjs",
    "contract:docs": "bun scripts/build-contract-docs.mjs",
    "contract:check": "bun scripts/extract-frontend-contract.mjs --check && bun scripts/build-contract-docs.mjs --check",
    "contract:harvest": "node scripts/contract-harvest.mjs",
    "contract:pending": "bun scripts/gen-contract-pending.mjs",
    "docs:openapi": "bun --no-env-file scripts/gen-openapi.ts",
    "docs:openapi:check": "bun --no-env-file scripts/gen-openapi.ts --check",
    "coverage:build": "bun scripts/build-coverage.mjs",
    "coverage:check": "bun scripts/build-coverage.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@bull-board/api": "^9.10.5",
    "@bull-board/fastify": "^9.10.5",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@node-rs/argon2": "^2.2.2",
    "@scalar/nestjs-api-reference": "^1.2.34",
    "bullmq": "^6.5.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.3.2",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
